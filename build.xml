<?xml version="1.0" encoding="UTF-8"?>
<project name="cladinator" default="jar" basedir=".">

    <property name="src.dir" value="src"/>
    <property name="test.dir" value="test"/>
    <property name="lib.dir" value="lib"/>
    <property name="build.dir" value="build"/>
    <property name="classes.dir" value="${build.dir}/classes"/>
    <property name="test.classes.dir" value="${build.dir}/test-classes"/>
    <property name="dist.dir" value="dist"/>
    <!-- lib/forester.jar is forester (https://github.com/cmzmasek/forester, GPL-3.0-or-later), built with
         "ant all" in forester/java at the commit below. To update it: rebuild from a newer forester commit,
         copy the jar here, change these three properties (the build checks the checksum) and note the new
         version under Changes in README.md. -->
    <property name="forester.jar" value="${lib.dir}/forester.jar"/>
    <property name="forester.version" value="0.11.159"/>
    <property name="forester.commit" value="191a3dc9ee2bafc8276ec3290c317d196873ef6d"/>
    <property name="forester.sha256" value="64f78781f2933327d142ec2f8ddaada761ee0991f4960b87749768bdcaad2e22"/>
    <!-- JUnit's single-jar console launcher, downloaded on first use (git-ignored) -->
    <property name="junit.version" value="6.1.3"/>
    <property name="junit.sha256" value="e62b96ac475dbcde8599ea905d088f65d90778f86e259b856a49fa5c4ea256ec"/>
    <property name="junit.jar" value="${lib.dir}/junit-platform-console-standalone-${junit.version}.jar"/>
    <property name="main.class" value="org.cladinator.cladinator"/>

    <path id="compile.classpath">
        <pathelement location="${forester.jar}"/>
    </path>

    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <!-- lib/forester.jar must be the recorded forester build, so that the record stays true -->
    <target name="forester-jar">
        <checksum file="${forester.jar}" algorithm="SHA-256" property="${forester.sha256}" verifyproperty="forester.jar.ok"/>
        <fail message="${forester.jar} is not the recorded forester build (${forester.version}, commit ${forester.commit}); if you replaced it on purpose, update forester.version, forester.commit and forester.sha256 in build.xml and note the new version in README.md">
            <condition>
                <isfalse value="${forester.jar.ok}"/>
            </condition>
        </fail>
    </target>

    <target name="compile" depends="forester-jar">
        <mkdir dir="${classes.dir}"/>
        <javac release="21" debug="true" debuglevel="lines,source" srcdir="${src.dir}"
               destdir="${classes.dir}" encoding="UTF-8" includeantruntime="false"
               classpathref="compile.classpath"/>
    </target>

    <!-- dist/cladinator.jar finds forester.jar next to it via the manifest Class-Path -->
    <target name="jar" depends="compile">
        <mkdir dir="${dist.dir}"/>
        <jar destfile="${dist.dir}/cladinator.jar" basedir="${classes.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
                <attribute name="Class-Path" value="forester.jar"/>
            </manifest>
        </jar>
        <copy file="${forester.jar}" todir="${dist.dir}"/>
    </target>

    <target name="junit-jar">
        <get src="https://repo1.maven.org/maven2/org/junit/platform/junit-platform-console-standalone/${junit.version}/junit-platform-console-standalone-${junit.version}.jar"
             dest="${junit.jar}" skipexisting="true"/>
        <checksum file="${junit.jar}" algorithm="SHA-256" property="${junit.sha256}" verifyproperty="junit.jar.ok"/>
        <fail message="${junit.jar} does not have the expected SHA-256 checksum; delete it and run again">
            <condition>
                <isfalse value="${junit.jar.ok}"/>
            </condition>
        </fail>
    </target>

    <target name="compile-tests" depends="compile,junit-jar">
        <mkdir dir="${test.classes.dir}"/>
        <javac release="21" debug="true" srcdir="${test.dir}" destdir="${test.classes.dir}"
               encoding="UTF-8" includeantruntime="false">
            <classpath>
                <path refid="compile.classpath"/>
                <pathelement location="${classes.dir}"/>
                <pathelement location="${junit.jar}"/>
            </classpath>
        </javac>
    </target>

    <target name="test" depends="jar,compile-tests">
        <java jar="${junit.jar}" fork="true" failonerror="true" dir="${basedir}">
            <arg value="execute"/>
            <arg value="--class-path"/>
            <arg path="${forester.jar}:${classes.dir}:${test.classes.dir}"/>
            <arg value="--scan-class-path"/>
            <arg value="--fail-if-no-tests"/>
            <arg value="--disable-banner"/>
            <arg value="--details=summary"/>
        </java>
        <!-- command-line regression tests against dist/cladinator.jar -->
        <exec executable="bash" failonerror="true" dir="${basedir}">
            <arg value="test/cli_test.sh"/>
        </exec>
    </target>

</project>
